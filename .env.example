# Local demo runs without any credentials. Use MODE=live for Airtable.
MODE=demo
HOST=127.0.0.1
PORT=8787
# Required in live mode: per-editor, random 32+ character tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EDITOR_TOKENS={"editor@example.com":"paste-a-generated-token-here"}
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
# Optional: map keys to your Airtable column names (all values are strings).
# AIRTABLE_FIELDS={"title":"Title","organization":"Organization","summary":"Summary","url":"URL","deadline":"Deadline","category":"Category","status":"Status"}
# Status single-select values must exist in Airtable.
# AIRTABLE_STATUSES={"pending":"pending","approved":"approved","rejected":"rejected"}
# Optional Ghost integration; use its Admin API URL origin, not a Content API key.
GHOST_URL=
GHOST_ADMIN_KEY=
# For a deployed server, bind HOST=0.0.0.0 behind an HTTPS reverse proxy.
# Store DATA_DIR on a persistent disk. Run one server instance.
DATA_DIR=./data
