# Mode: "demo" (default) or "live"
MODE=demo

# Server binding
HOST=127.0.0.1
PORT=8787

# Data directory (default: ./data)
# DATA_DIR=./data

# Editor tokens — JSON map of email to token
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EDITOR_TOKENS={"editor@example.com":"your-random-hex-token"}

# Airtable (required for live mode)
# AIRTABLE_TOKEN=your-personal-access-token
# AIRTABLE_BASE_ID=appYourBase
# AIRTABLE_TABLE_ID=tblYourTable
# AIRTABLE_FIELDS={"title":"Title","organization":"Organization","summary":"Summary"}
# Optional columns that improve suggestion ranking (see LLM section below). When
# present they are authoritative; when absent the model infers them from the text.
#   region        — geographic reach, e.g. "Global", "Europe", "Nigeria"
#   funderCountry — the funder's country; drives the blocked-country exclusion
# AIRTABLE_FIELDS={"title":"Title","organization":"Organization","summary":"Summary","region":"Region","funderCountry":"Funder Country"}
# AIRTABLE_STATUSES={"pending":"pending","approved":"approved","rejected":"rejected"}

# Ghost (optional — Airtable review works without it)
# GHOST_URL=https://your-ghost-site.com
# GHOST_ADMIN_KEY=integration-id:secret
# Approve also adds to each editor's working draft (the post open in Ghost, or the
# one picked in the panel). No post ID needed.
# GHOST_AUTO_ADD_ON_APPROVE=true
# Optional fallback when no working draft is selected (setting it also enables auto-add).
# GHOST_APPROVAL_POST_ID=your-ghost-post-or-page-id
# GHOST_APPROVAL_RESOURCE=posts

# LLM suggestion ranking (optional). When set, opportunities are ranked by
# urgency (deadline), geographic reach (global preferred), and funder — and
# opportunities from blocked-country funders (Russia, China) are hidden. Absent = off.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
# Required only if your key is an organization key not scoped to a workspace.
# Prefer a workspace-scoped key instead, in which case leave this unset.
# ANTHROPIC_WORKSPACE_ID=your-workspace-id
