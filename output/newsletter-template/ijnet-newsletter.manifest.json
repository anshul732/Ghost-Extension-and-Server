  "sourceMetadata": {
    "description": "General reusable Lexical template for the IJNet weekly newsletter family (Blueprints + Investigative editions). Every top-level node carries a `sectionLabel` so automation and localization can target sections independently. Values in {{double braces}} are placeholders to be filled per issue.",
    "controlledVocabularies": {
      "sectionLabels": [
        "EDITORS_NOTE",
        "INSIGHTS",
        "CASES",
        "RESOURCES",
        "UPDATES",
        "OPPORTUNITIES",
        "FOOTER"
      ],
      "itemTags_blueprints": [
        "DESIGN",
        "PRODUCT",
        "ACTION"
      ],
      "itemTags_investigative": [
        "FORENSICS",
        "SENSEMAKING",
        "ANALYSIS"
      ],
      "subHeaders": {
        "INSIGHTS": [
          "RESEARCH"
        ],
        "RESOURCES": [
          "BREAKDOWNS",
          "SPOTLIGHT"
        ],
        "UPDATES": [
          "TAKEAWAYS",
          "ANNOUNCEMENTS"
        ]
      },
      "translatable": [
        "editorsNote",
        "itemBody",
        "spotlight",
        "takeaway",
        "announcement",
        "opportunityTitle",
        "opportunityMeta"
      ],
      "doNotTranslate": [
        "tag",
        "sectionLabel",
        "byline_source",
        "deadline",
        "url",
        "sender/publisher names",
        "footer boilerplate"
      ]
    },
    "itemShape": "Every content item = { tag (from vocabulary), body (one sentence, one inline link), source (byline) }",
    "editionDefaults": {
      "blueprints": {
        "editor": "Priscila Brito",
        "signoff": "Until next Wednesday,",
        "tags": "itemTags_blueprints"
      },
      "investigative": {
        "editor": "H R Venkatesh, Editor, IJNet",
        "signoff": "Here's to the work that keeps power accountable!",
        "tags": "itemTags_investigative"
      }
    }
  },
